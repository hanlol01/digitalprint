FROM node:20-alpine

WORKDIR /app

# Copy package.json and install dependencies
COPY package*.json ./
RUN npm install

# Copy the rest of the application
COPY . .

# Expose Vite's default port
EXPOSE 5173

# Run the dev server and expose host so it's accessible outside the container
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
